#version 450
// Forward blend: dst[i] = 0.5*dst[i] + 0.5*src[i]. Vulkan counterpart of HIP/PM4
// k_blend. The forward twin of layer_revadd (same 0.5/0.5 contractive blend, but a
// coalesced forward read of src[i] instead of the mirrored src[n-1-i]). Used by
// CHAIN=serial: a realistic decode chain write->read->modify->write with DISTINCT
// pipelines bound per dispatch. binding0 = Dst (read+write), binding1 = Src (read).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Dst { float dst[]; };
layout(std430, binding = 1) readonly buffer Src { float src[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) dst[i] = 0.5 * dst[i] + 0.5 * src[i];
}
