#version 450
// Elementwise residual add: x[i] += w[i]. Matches HIP/PM4 k_add(x,w).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) x[i] = x[i] + w[i];
}
