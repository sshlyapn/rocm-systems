#version 450
// Plain copy: dst[i] = src[i]. Vulkan counterpart of HIP/PM4 k_copy(dst,src).
// A trivial elementwise kernel used in CHAIN=mix so all kernels compile to
// near-identical simple ISA across hipcc and RADV (no LDS reduction confound).
// binding0 = Dst (write), binding1 = Src (read).
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Dst { float dst[]; };
layout(std430, binding = 1) readonly buffer Src { float src[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) dst[i] = src[i];
}
